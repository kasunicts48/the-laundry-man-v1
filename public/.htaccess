DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # InfinityFree: serve existing files and folders directly (booking.html, locations.html, assets/, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA fallback — all other routes go to React index.html
  RewriteRule ^ index.html [L]
</IfModule>
