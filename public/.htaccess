DirectoryIndex index.html index.php

# Compress text assets for faster delivery on shared hosting.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Ensure video/media files are served with the correct MIME type.
# InfinityFree's Apache does not map these by default, which stops <video> from playing.
<IfModule mod_mime.c>
  AddType video/webm .webm
  AddType video/mp4 .mp4
  AddType image/webp .webp
  AddType image/svg+xml .svg
</IfModule>

# Allow byte-range requests so browsers can stream/seek the video.
# Cache policy: HTML always revalidates; hashed build assets can cache long-term.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(png|jpg|jpeg|gif|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>

  <FilesMatch "\.(webm|mp4)$">
    Header set Accept-Ranges bytes
    Header set Cache-Control "public, max-age=604800, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Legacy locations URL
  RewriteRule ^locations\.html$ /locations/ [R=301,L]

  # /locations and /locations/ → directory index (static locations page)
  RewriteRule ^locations/?$ /locations/index.html [L,QSA]

  # App download smart redirect (QR code destination)
  RewriteRule ^download-app/?$ /download-app/index.html [L,QSA]

  # InfinityFree: serve existing files and folders directly (booking.html, locations/, assets/, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA fallback — all other routes go to React index.html
  RewriteRule ^ index.html [L]
</IfModule>
