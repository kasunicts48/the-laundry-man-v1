# Template only — copy to .env and fill in your real values:
#   cp .env.example .env
#
# send-email.php reads this file at runtime (public/api/.env).

APP_ENV=production

# Admin inbox for booking + contact notifications
LAUNDRY_SERVICE_EMAIL=strainer1362@gmail.com

# Live SMTP (One.com or your mail provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=strainer1362@gmail.com
SMTP_PASSWORD=your_mailbox_password

# Authorized sender (must exist on your mail host)
MAIL_FROM_EMAIL=info@thelaundryman.co.uk
MAIL_FROM_NAME=The Laundry Man Website
CUSTOMER_SUBJECT_PREFIX=Your Booking Confirmation
CONTACT_SUBJECT_PREFIX=Website Contact Enquiry

# Customer confirmation is sent to the email address submitted in the booking form.
# Optional: dev/test fallback when the form email is missing (defaults to LAUNDRY_SERVICE_EMAIL)
# CUSTOMER_EMAIL_FALLBACK=you@example.com
#
# Gmail SMTP: MAIL FROM must match SMTP_USERNAME; branded address is used as Reply-To on customer emails.
