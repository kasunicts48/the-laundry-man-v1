# Template only — copy to .env and fill in your real values:
#   cp .env.example .env
#
# send-email.php reads .env (this file is NOT loaded at runtime).
DEVELOPMENT_MODE=true

# Mailtrap Sandbox SMTP (required when DEVELOPMENT_MODE=true)
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USERNAME=your_mailtrap_username
MAILTRAP_PASSWORD=your_mailtrap_password
# Inbox that receives booking notifications
NOTIFICATION_RECEIVER_EMAIL=info@thelaundryman.co.uk
